{
  "mcpServers": {
    "playwright": {
      "name": "playwright",
      "command": "npx",
      "args": ["-y", "@executeautomation/playwright-mcp-server"],
      "disabled": false,
      "timeout": 60
    },
    {

    "linear": {
      "name": "linear",
      "command": "/usr/local/bin/linear-mcp-go",
      "args": ["serve", "--write-access=false"],
      "disabled": false,
      "env": { "LINEAR_API_KEY": "${exec:printenv LINEAR_API_KEY}" }
    
  }
}
  }
}
